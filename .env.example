# PostgreSQL. Locally: `npm run db:up` starts one via docker-compose on port 5435.
DATABASE_URL="postgresql://vaultx:vaultx_dev_password@localhost:5435/vaultx"
# Direct (non-pooled) connection used by Prisma migrations. Locally the same as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://vaultx:vaultx_dev_password@localhost:5435/vaultx"

# Secret for signing session JWTs (32+ random characters). Generate: openssl rand -hex 32
AUTH_SECRET=""

# Bearer token required by /api/cron/match (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`)
CRON_SECRET=""
